{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/visual-first-ppt/project-artifacts.schema.json",
  "title": "Visual-First PPT project artifacts",
  "$defs": {
    "projectManifest": {
      "type": "object",
      "required": ["artifactType", "schemaVersion", "projectId", "title", "route", "workspace", "inputHashes", "toolVersions", "createdAt", "updatedAt"],
      "properties": {
        "artifactType": { "const": "projectManifest" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string", "pattern": "^ppt-[A-Za-z0-9-]+$" },
        "title": { "type": "string", "pattern": ".+" },
        "route": { "enum": ["create", "template", "edit"] },
        "workspace": { "type": "string", "pattern": ".+" },
        "inputHashes": { "type": "object", "additionalProperties": { "type": "string" } },
        "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "finalOutputRoot": { "type": "string", "pattern": ".+" },
        "finalOutputPath": { "type": "string", "pattern": ".+" }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["artifactType", "schemaVersion", "projectId", "route", "status", "approvals", "blockers", "completedBatches", "inputHashes", "invalidations", "updatedAt"],
      "properties": {
        "artifactType": { "const": "state" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string", "pattern": "^ppt-[A-Za-z0-9-]+$" },
        "route": { "enum": ["create", "template", "edit"] },
        "status": { "enum": ["INTAKE", "SOURCE_READY", "OUTLINE_REVIEW", "OUTLINE_APPROVED", "VISUAL_REVIEW", "VISUAL_LOCKED", "COMPATIBILITY_REVIEW", "SCOPE_REVIEW", "SCOPE_APPROVED", "CHANGE_PREVIEW", "BUILDING", "QA", "FINAL_REVIEW", "DELIVERED", "BLOCKED_SOURCE", "BLOCKED_COMPATIBILITY"] },
        "approvals": { "type": "object", "additionalProperties": { "type": "object" } },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "reason", "createdAt"],
            "properties": {
              "type": { "enum": ["BLOCKED_SOURCE", "BLOCKED_COMPATIBILITY"] },
              "reason": { "type": "string", "pattern": ".+" },
              "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
            },
            "additionalProperties": false
          }
        },
        "completedBatches": { "type": "array", "items": { "type": "object" } },
        "inputHashes": { "type": "object", "additionalProperties": { "type": "string" } },
        "invalidations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["impact", "changedArtifactHash", "reason", "invalidatedApprovals", "affectedPages", "invalidatedAt", "previousState"],
            "properties": {
              "impact": { "enum": ["narrative", "visual", "scope"] },
              "changedArtifactHash": { "type": "string", "pattern": ".+" },
              "reason": { "type": "string", "pattern": ".+" },
              "invalidatedApprovals": { "type": "array", "items": { "type": "string" } },
              "affectedPages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
              "invalidatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
              "previousState": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "blockedFrom": { "type": "string" },
        "blockedInputHashes": { "type": "object", "additionalProperties": { "type": "string" } },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      },
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "required": ["artifactType", "schemaVersion"],
      "properties": {
        "artifactType": { "const": "brief" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string" },
        "route": { "enum": ["create", "template", "edit"] },
        "audience": { "type": "string" },
        "objective": { "type": "string" },
        "decision": { "type": "string" },
        "length": { "type": "integer", "minimum": 1 },
        "deadline": { "type": "string" },
        "language": { "type": "string" },
        "brandConstraints": { "type": "array", "items": { "type": "string" } },
        "speakerContext": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "openQuestions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sourceLedger": {
      "type": "object",
      "required": ["artifactType", "schemaVersion"],
      "properties": {
        "artifactType": { "const": "sourceLedger" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceId", "type", "title", "location", "provenance", "usageBoundary", "hash"],
            "properties": {
              "sourceId": { "type": "string" },
              "type": { "type": "string" },
              "title": { "type": "string" },
              "location": { "type": "string" },
              "provenance": { "type": "string" },
              "usageBoundary": { "type": "string" },
              "hash": { "type": "string" },
              "verifiedAt": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outline": {
      "type": "object",
      "required": ["artifactType", "schemaVersion"],
      "properties": {
        "artifactType": { "const": "outline" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string" },
        "route": { "enum": ["create", "template", "edit"] },
        "title": { "type": "string" },
        "slides": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
        "approvalHash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "themeLock": {
      "type": "object",
      "required": ["artifactType", "schemaVersion"],
      "properties": {
        "artifactType": { "const": "themeLock" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string" },
        "sourcePriority": { "type": "array", "items": { "type": "string" } },
        "themeId": { "type": "string" },
        "visualSamplePath": { "type": "string" },
        "sampleHash": { "type": "string" },
        "approvalHash": { "type": "string" },
        "strictTemplate": { "type": "boolean" },
        "templateHash": { "type": "string" },
        "compatibilityStatus": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slideSpecs": {
      "type": "object",
      "required": ["artifactType", "schemaVersion"],
      "properties": {
        "artifactType": { "const": "slideSpecs" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string" },
        "slides": { "type": "array", "items": { "type": "object" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "qaReport": {
      "type": "object",
      "required": ["artifactType", "schemaVersion", "projectId", "inputHashes", "toolVersions", "automatedChecks", "perSlideManualScores", "clientSmokeStatus", "evidencePaths", "finalVerdict"],
      "properties": {
        "artifactType": { "const": "qaReport" },
        "schemaVersion": { "const": "1.0.0" },
        "projectId": { "type": "string" },
        "route": { "enum": ["create", "template", "edit"] },
        "inputHashes": { "type": "object", "additionalProperties": { "type": "string" } },
        "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
        "automatedChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "evidencePath"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["PASS", "FAIL"] },
              "evidencePath": { "type": "string" },
              "value": { "type": "number" },
              "command": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "perSlideManualScores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slide", "score", "evidencePath"],
            "properties": {
              "slide": { "type": "integer", "minimum": 1 },
              "score": { "type": "integer", "minimum": 1 },
              "dimensions": {
                "type": "object",
                "properties": {
                  "readability": { "type": "integer", "minimum": 1 },
                  "visualConsistency": { "type": "integer", "minimum": 1 },
                  "imageIntegrity": { "type": "integer", "minimum": 1 },
                  "visualContractFidelity": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              },
              "reviewer": { "type": "string" },
              "evidencePath": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "clientSmokeStatus": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "clientSmoke": {
          "type": "object",
          "properties": {
            "status": { "enum": ["passed", "failed", "not_available"] },
            "evidencePath": { "type": "string" },
            "userFinalOpenConfirmation": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "evidencePaths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "finalVerdict": { "enum": ["PASS", "FAIL"] },
        "generatedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "themeCatalog": {
      "type": "object",
      "required": ["artifactType", "schemaVersion"],
      "properties": {
        "artifactType": { "const": "themeCatalog" },
        "schemaVersion": { "const": "1.0.0" },
        "themes": { "type": "array", "items": { "type": "object" }, "minItems": 1 }
      },
      "additionalProperties": false
    }
  }
}
